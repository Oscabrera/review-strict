{
  "type": "object",
  "required": [
    "repo",
    "stack",
    "generated_for",
    "entities",
    "relationships",
    "flows",
    "lifecycle",
    "confidence",
    "coverage",
    "scorecard",
    "risks",
    "recommendations",
    "roadmap",
    "open_questions"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "generated_for": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "pk",
                "fk",
                "nullable"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "pk": {
                  "type": "boolean"
                },
                "fk": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "via"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "via": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "desc"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "desc": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "states",
        "transitions"
      ],
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "on",
              "rules"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "on": {
                "type": "string",
                "minLength": 1
              },
              "rules": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": [
        "verified_meaning",
        "security_severities_conditional_on",
        "exposure_signal",
        "blast_radius"
      ],
      "properties": {
        "verified_meaning": {
          "type": "string",
          "minLength": 1
        },
        "security_severities_conditional_on": {
          "type": "string",
          "minLength": 1
        },
        "exposure_signal": {
          "type": "string",
          "minLength": 1
        },
        "blast_radius": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "traced",
        "shallow",
        "not_audited"
      ],
      "properties": {
        "traced": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shallow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_audited": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scorecard": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "score",
          "top_finding",
          "detail"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "top_finding": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "severity"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "impact",
          "effort",
          "priority",
          "quick_win"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "enum": [
              "H",
              "M",
              "L"
            ]
          },
          "effort": {
            "enum": [
              "H",
              "M",
              "L"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "quick_win": {
            "type": "boolean"
          }
        }
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "objetivo",
          "tareas",
          "riesgo",
          "rollback",
          "aceptacion"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "objetivo": {
            "type": "string",
            "minLength": 1
          },
          "tareas": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "riesgo": {
            "type": "string",
            "minLength": 1
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          },
          "aceptacion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit-strict bundle v0"
}
